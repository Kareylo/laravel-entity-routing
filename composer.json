{
    "name": "kareylo/laravel-entity-routing",
    "description": "Entity routing for Laravel: fill every route placeholder from a single model, array or object.",
    "keywords": ["laravel", "routing", "url-generation", "eloquent", "entity-routing"],
    "homepage": "https://github.com/Kareylo/laravel-entity-routing",
    "license": "MIT",
    "authors": [
        {
            "name": "Kareylo",
            "email": "contact@kareylo.fr"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.48|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.48|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.48|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.11|^3.9.3",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^8.22|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.36|^3.8|^4.1",
        "pestphp/pest-plugin-laravel": "^2.4|^3.2|^4.1"
    },
    "autoload": {
        "psr-4": {
            "Kareylo\\EntityRouting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kareylo\\EntityRouting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kareylo\\EntityRouting\\EntityRoutingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "pest --coverage --min=80"
        ],
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
